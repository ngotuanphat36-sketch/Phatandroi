-- 4. Dịch chuyển về Lửa Trại
createButton("🔥 Dịch Chuyển Về Lửa Trại", 150, function()
    local char = localPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local targetPos = nil
        for _, v in ipairs(workspace:GetDescendants()) do
            if v.Name:lower():find("campfire") or v.Name:lower():find("fire") then
                if v:IsA("BasePart") then
                    targetPos = v.Position
                    break
                elseif v:IsA("Model") and v.PrimaryPart then
                    targetPos = v.PrimaryPart.Position
                    break
                elseif v:IsA("Model") then
                    for _, part in ipairs(v:GetChildren()) do
                        if part:IsA("BasePart") then
                            targetPos = part.Position
                            break
                        end
                    end
                    if targetPos then break end
                end
            end
        end
        
        if targetPos then
            char.HumanoidRootPart.CFrame = CFrame.new(targetPos + Vector3.new(0, 3, 0))
            print("Đã dịch chuyển về lửa trại thành công!")
        else
            print("Không tìm thấy lửa trại trong bản đồ hiện tại!")
        end
    end
end)

