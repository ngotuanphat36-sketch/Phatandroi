-- 6. NÚT CHUYÊN DỤNG: Đem toàn bộ gỗ/vật phẩm về lửa trại ngay lập tức
createButton("📦 Đem Toàn Bộ Gỗ/Vật Phẩm Về Lửa Trại", 250, function()
    local campfirePart = nil
    for _, v in ipairs(workspace:GetDescendants()) do
        if v.Name:lower():find("campfire") or v.Name:lower():find("fire") then
            if v:IsA("BasePart") then
                campfirePart = v
                break
            elseif v:IsA("Model") and v.PrimaryPart then
                campfirePart = v.PrimaryPart
                break
            end
        end
    end

    if campfirePart then
        local count = 0
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Model") or obj:IsA("BasePart") then
                local name = obj.Name:lower()
                if name:find("wood") or name:find("log") or name:find("branch") or name:find("fuel") or name:find("item") or name:find("child") or name:find("kid") then
                    local part = obj:IsA("BasePart") and obj or obj.PrimaryPart or obj:FindFirstChildOfClass("BasePart")
                    if part then
                        part.CFrame = campfirePart.CFrame + Vector3.new(math.random(-3, 3), 1, math.random(-3, 3))
                        count = count + 1
                    end
                end
            end
        end
        print("Đã gom và đem " .. count .. " vật phẩm/gỗ về lửa trại thành công!")
    else
        print("Không tìm thấy lửa trại trên bản đồ!")
    end
end)

